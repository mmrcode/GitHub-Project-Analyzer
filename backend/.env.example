# GitHub Project Analyzer Environment Variables

# Google Free Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Default Gemini model for analysis and Q&A (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=
